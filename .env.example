# Backend-only configuration. Copy to rag_service/.env and replace placeholders.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
DATABASE_NAME=aeip_db
AEIP_SECRET_KEY=replace-with-at-least-32-random-bytes
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GEMINI_API_KEY=
# Optional: set both to seed the first administrator; existing accounts are never overwritten.
AEIP_ADMIN_EMAIL=
AEIP_ADMIN_PASSWORD=
